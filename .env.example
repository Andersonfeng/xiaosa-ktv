# 潇洒K歌 · 部署配置模板
# 用法：cp .env.example .env 然后按需修改。docker compose 会自动读取同目录的 .env。

# 宿主机访问端口（浏览器打开 http://服务器IP:<KTV_PORT>）
KTV_PORT=8083

# 管理后台（/admin）密码 —— 务必改掉
ADMIN_PASSWORD=admin888

TZ=Asia/Shanghai

# 应用数据目录（数据库/封面/HLS 缓存），建议保留默认
KTV_DATA_DIR=./ktv-data/data

# 本地曲库目录：可以直接指向宿主机上已有的 MV 文件夹，例如 /mnt/disk/mv
KTV_MV_DIR=./ktv-data/mv

# 网络/网盘曲库目录（可选）
KTV_MV_NET_DIR=./ktv-data/mv-net

# 歌手头像目录（可选，文件名 = 歌手名，如 周杰伦.jpg）
KTV_SINGER_DIR=./ktv-data/singer

# HLS 转码缓存保留天数
HLS_CACHE_MAX_AGE_DAYS=3

# 只在用 docker-compose.release.yml（不构建、直接拉镜像）时生效：
# KTV_IMAGE=andersonfeng/xiaosa-ktv:1.0.0

