#!/bin/bash
source "$(dirname "$0")/lib_settings.sh"

# 1.3.1 新增 mv-net / singer 两个共享目录；老版本升级上来的机器需要在这里
# 补建一次，避免 docker compose 挂载不存在的目录时报错。
mkdir -p "$(default_data_path)"
mkdir -p "$(default_mv_path)"
mkdir -p "$(default_mv_net_path)"
mkdir -p "$(default_singer_path)"

# 管理员密码现在由 docker-compose.yml 的 ADMIN_PASSWORD 环境变量定义，
# 升级流程不需要再收集或迁移向导输入。
exit 0
